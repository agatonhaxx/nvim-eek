{
    "devenv": {
        "prefix": "devenv",
        "body": [
          "{ pkgs, lib, config, inputs, ... }:",
          "{",
          "\t# 1. Environment Variables",
          "\t# Set environment variables automatically when entering the shell",
          "\tdotenv.enable = ${1|true,false};",
          "\tenv = {",
          "\t\t$1{1:envvars}",
          "\t};",
          "",
          "\t# 2. Language Runtimes",
          "\t# Built-in support for managing languages and their package managers",
          "\tlanguages = {",
          "\t\t$2{2:language}",
          "",
          "\t# 3. Comprehensive Tooling Suite",
          "\tpackages = with pkgs; [",
          "\t\t# Secrets & Cryptography",
          "\t\tsops",
          "\t\tage",
          "\t\tgitleaks # Strictly prevents committing secrets",
          "\t];",
          "",
          "\t# 4. Automation & Maintenance Scripts",
          "\tscripts = {",
          "\t\t$4{4:scripts};",
          "\t};",
          "",
          "\t# 5. Background Infrastructure Services",
          "\tservices = {",
          "\t\t$5{5:services}",
          "\t\t};",
          "",
          "\t# 6. Process Supervision (devenv up)",
          "\tprocesses = {",
          "\t\t$6{6:processes}",
          "\t};",
          "",
          "\t# 7. Strict Universal Formatting Suite (Treefmt)",
          "\ttreefmt = {",
          "\t\tenable = true;",
          "\t\tconfig.programs = {",
          "\t\t\t# Nix System Configuration",
          "\t\t\t$7{7:formatters}",
          "\t\t\tnixpkgs-fmt.enable = true;",
          "\t\t\t# Spell-check text files only (not code)",
          "\t\t\ttypos = {",
          "\t\t\t\tenable = true;",
          "\t\t\t\tincludes = lib.mkForce [",
          "\t\t\t\t\t*.md\"",
          "\t\t\t\t\t*.txt\"",
          "\t\t\t\t\t*.csv\"",
          "\t\t\t\t\t*.adoc\"",
          "\t\t\t\t\t*.rst\"",
          "\t\t\t\t];",
          "\t\t\t};",
          "\t\t};",
          "\t};",
          "",
          "\t# 8. Strict Quality Gates & Git Hooks",
          "\tgit-hooks = {",
          "\t\thooks = {",
          "\t\t\t# --- Tier 1: Auto-Formatting ---",
          "\t\t\ttreefmt.enable = true; # Automatically formats files before allowing commit",
          "\t\t\t# typos is handled by treefmt above — no standalone hook needed",
          "\t\t\t# --- Tier 2: Hard Security Gates (Custom Defined) ---",
          "\t\t\tgitleaks-hook = {",
          "\t\t\t\tenable = true;",
          "\t\t\t\tname = \"Gitleaks Security Scanner\";",
          "\t\t\t\t# entry points directly to the gitleaks binary from your pkgs definition",
          "\t\t\t\t# '--staged' optimizes the run to only scan files sitting in your Git index",
          "\t\t\t\tentry = \"${pkgs.gitleaks}/bin/gitleaks protect --verbose --staged\";",
          "\t\t\t\t# This tells the hook engine to evaluate every single file type",
          "\t\t\t\tfiles = \".*\";",
          "\t\t\t\t# This locks execution exactly to the pre-commit phase",
          "\t\t\t\tstages = [ \"pre-commit\" ];",
          "\t\t\t\tpass_filenames = false; # Gitleaks protect checks the index, not individual file paths",
          "\t\t\t};",
          "\t\t\t# --- Tier 3: Strict Language Linters ---",
          "\t\t\t$8{8:linters}",
          "\t\t\t};",
          "\t\t};",
          "\t};",
          "",
          "\t# 9. Environment Initialization Sandbox",
          "\tenterShell = ''",
          "\t\techo \"=========================================================\"",
          "\t\techo \"🛡️  SECURE & STRICT DEVELOPMENT ENVIRONMENT ENFORCED 🛡️\"",
          "\t\techo \"=========================================================\"",
          "\t\techo \"  Startup:\"",
          "\t\techo \"    devenv up           →  start devenv and processes\"",
          "\t\techo \"\"",
          "\t\techo \"  Manual run:\"",
          "\t\techo \"\"",
          "\t\techo \"  Strict rules are active via pre-commit hooks.\"",
          "\t\techo \"  Commits will fail automatically if quality bars are missed.\"",
          "\t\techo \"=========================================================\"",
          "\t\t# Proactively check code quality posture right when entering developer shell",
          "\t\t# treefmt --check",
          "\t'';",
          "\t}"
        ],
        "description": "Devenv skeleton",
        "scope": "devenv.nix"
    },
    {
    "sops-script": {
        "prefix": "sops-script",
        "body": [
          "\t\t# Strict secret management",
          "\t\tsops-decrypt.exec = ''",
          "\t\tif [ -f .sops.yaml ] && [ -f secrets.env ]; then",
          "\t\techo \"🔓 Decrypting environment secrets safely...\"",
          "\t\tsops -d secrets.env > .env",
          "\t\telse",
          "\t\techo \"❌ Error: Missing configuration (.sops.yaml) or encrypted payload.\"",
          "\t\texit 1",
          "\t\tfi",
          "\t'';",
          "",
          "\tsops-encrypt.exec = \"sops -e secrets.yaml > secrets.enc.yaml\";",
          ""
        ],
        "description": "Sops script",
        "scope": "devenv.nix"
    },
    {
    "ci-strict": {
        "prefix": "ci-strict",
        "body": [
          "\t# Continuous Integration Simulator (Runs the exact strict pipeline locally)",
          "\tci-local.exec = ''",
          "\t\techo \"🛡️  Running strict validation pipeline..\.",
          "\t\techo \"1. Code Formatting Check\" && treefmt --fail-on-change || exit 1",
          "\t\techo \"2. Security Scan\" && gitleaks detect --verbose || exit 1",
          "\t\techo \"3. Go Linters\" && golangci-lint run ./... || exit 1",
          "\t\techo \"4. Go test\" && go test ./... || exit 1",
          "\t\techo \"🚀 All strict checks passed!\"",
          "\t'';"
        ],
        "description": "CI Strict",
        "scope": "devenv.nix"
    },
    {
    "python-lang": {
        "prefix": "python-lang",
        "body": [
            "\tpython = {",
            "\t\tenable = true;",
            "\t\tversion = \"$1{1:version}\";",
            "\t\tpoetry = {",
            "\t\t\tenable = $2{2|true|false};",
            "\t\t\tactivate.enable = $3{3|true|false};",
            "\t\t\tinstall.enable = $4{4|true|false};",
            "\t\t};",
            "\t};"
        ],
        "description": "Python Language",
        "scope": "devenv.nix"
},

{
    "javascript-lang": {
        "prefix": "javascript-lang",
        "body": [
            "\tjavascript = {",
            "\t\tenable = true;",
            "\t\tversion = \"$1{1:version}\";",
            "\t\tnpm.enable = $2{|true|false};",
            "\t\t};",
            "\t};"
        ],
        "description": "Javascript Language",
        "scope": "devenv.nix"
},

{
    "postgress-service": {
        "prefix": "postgress-service",
        "body": [
            "\t\tpostgres = {",
            "\t\t\tenable = true;",
            "\t\t\tlisten_addresses = \"127.0.0.1\";",
            "\t\t\tinitialDatabases = [",
            "\t\t\t\t{ name = \"myapp_dev\"; }",
            "\t\t\t];",
            "\t\t\tinitialScript = ''",
            "\t\t\t\tCREATE USER developer WITH PASSWORD 'secret' SUPERUSER;",
            "\t\t\t'';"
        ],
        "description": "Postgress Service",
        "scope": "devenv.nix"
  },
  {
    "go-lint": {
        "prefix": "go-lint",
        "body": [
          "\t\t\t# Go Language Diagnostics",
          "\t\t\tgolangci-lint = {",
          "\t\t\t\tenable = true;",
          "\t\t\t# Enforce all configured rules inside your project's local `.golangci.yml`"
        ],
        "description": "Go Linter",
        "scope": "devenv.nix"
          }
